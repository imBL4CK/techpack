[slime]
	#Slime Blobs Enabled
	enabled = true
	#Slime blob RGB color (0x000000 - 0xFFFFFF)
	# Default: 8978297
	# Range: 0 ~ 16777215
	color = 8978297

[charge]
	#Charge Particle Enabled
	enabled = true

[waterCircle]
	#Water Circles Enabled
	enabled = true
	#Water Circles Colored
	colored = true
	#Water Circles Density
	# Default: 16
	# Range: 0 ~ 64
	density = 16
